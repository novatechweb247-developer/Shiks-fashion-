{
  "entities": {
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global website settings and contact configuration for Shiks Fashion",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "shortName": { "type": "string" },
        "tagline": { "type": "string" },
        "location": { "type": "string" },
        "phone": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "email": { "type": "string" },
        "heroImage": { "type": "string" },
        "aboutImage": { "type": "string" },
        "academyImage": { "type": "string" },
        "footerDescription": { "type": "string" },
        "copyrightText": { "type": "string" }
      }
    },
    "PageContent": {
      "title": "PageContent",
      "description": "Structured content for public pages",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "description": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "MediaItem": {
      "title": "MediaItem",
      "description": "Individually stored uploaded image to prevent 1MB document limit",
      "type": "object",
      "properties": {
        "dataUrl": { "type": "string" },
        "name": { "type": "string" },
        "size": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["dataUrl", "createdAt"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Customer inquiry and consultation requests",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "enquiryType": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["fullName", "phone", "message"]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": "SiteSettings",
      "description": "Global settings for branding, contact, and header/footer"
    },
    "/pagesDrafts/{pageId}": {
      "schema": "PageContent",
      "description": "Draft versions of page content"
    },
    "/pagesPublished/{pageId}": {
      "schema": "PageContent",
      "description": "Published versions of page content loaded by public site"
    },
    "/media/{mediaId}": {
      "schema": "MediaItem",
      "description": "Uploaded media items stored individually to prevent document size exhaustion"
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Consultation bookings and contact form submissions"
    }
  }
}
